# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# PostgreSQL connection string (Neon / Vercel Postgres / any Postgres 13+)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# First admin account (created automatically when no admin exists yet)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Random string, at least 32 characters (signs login sessions)
SESSION_SECRET=

# Optional: automatic reading of uploaded documents (Claude API)
ANTHROPIC_API_KEY=

# Optional: "Forgot password" emails via https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Immigration History <onboarding@resend.dev>
APP_URL=https://your-app.vercel.app

# Optional: set to 1 only for single-connection local test databases
# DB_POOL_MAX=1
